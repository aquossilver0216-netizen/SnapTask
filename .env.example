# Mac内Gemma（LM Studio / Bionic）の接続先
LOCAL_GEMMA_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_GEMMA_MODEL=google/gemma-4-e4b

# APIモードへ切り替える場合（キーはブラウザに書かない）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 課金（Stripe Checkout）: 未設定なら購入ボタンは決済を開始しません
STRIPE_SECRET_KEY=
# テストモード用Price ID
STRIPE_PRICE_ID_PREMIUM=
# 本番モード用Price ID（Live modeで作成したもの）
STRIPE_PRICE_ID_PREMIUM_LIVE=
# true/未設定=テストキーのみ許可。ライブ課金へ切り替えるときは、Stripeの本番価格IDとsk_live_キーを設定してfalseに変更
STRIPE_TEST_MODE=true
APP_URL=https://snap-task-xi.vercel.app
